# Copy to .env and replace every placeholder. Never commit .env.
# Plain DNS names; no protocol or path. Both point to the supervisor's server.
CATALOG_HOST=catalog.example.org
PUBLISHER_HOST=publisher.example.org
ACME_EMAIL=researcher@example.org
CATALOG_MODE=solid
CATALOG_PUBLIC_URL=https://catalog.example.org
CATALOG_CORS_ORIGINS=https://publisher.example.org
# Compose derives public URL/CORS from the two hostnames above.

FUSEKI_IMAGE=stain/jena-fuseki:5.1.0
FUSEKI_URL=http://fuseki:3030/solid
FUSEKI_USER=admin
FUSEKI_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
FUSEKI_TIMEOUT_SECONDS=10

# External TMDT registry. Confirm it is readable by the catalog server.
SOLID_REGISTRY_URL=https://REPLACE_WITH_TMDT_REGISTRY/container/
SOLID_REGISTRY_CONTRACT_PATH=config/solid-registry-contract.yaml
# Zero means recheck on every publication. Nonzero means a bounded revocation delay.
SOLID_REGISTRY_CACHE_TTL_SECONDS=0
SOLID_AUTH_MODE=oidc
SOLID_AUTH_REQUIRE_DPOP=true
# Exact issuer, including any trailing slash from provider metadata.
SOLID_OIDC_ISSUER=https://REPLACE_WITH_TMDT_ISSUER/
SOLID_OIDC_AUDIENCE=solid
SOLID_DPOP_MAX_AGE_SECONDS=300
CATALOG_STARTUP_WAIT_SECONDS=60
SPARQL_MAX_REQUEST_BYTES=32768
SPARQL_MAX_ROWS=500
SPARQL_MAX_RESPONSE_BYTES=2097152
SPARQL_TIMEOUT_SECONDS=10
